<div class="flex flex-col h-screen">
  <header class="flex items-center justify-between p-4 border-b border-base-300 bg-base-100">
    <h1 class="text-xl font-bold font-brand">{@room && @room.name}</h1>
    <div class="flex items-center gap-2">
      <button
        phx-click="toggle_sidebar"
        class="btn btn-ghost btn-sm md:hidden min-h-[44px]"
        aria-label="Participantes"
      >
        👥
      </button>
      <.link navigate={~p"/rooms"} class="btn btn-ghost min-h-[44px]">
        ← Salas
      </.link>
    </div>
  </header>

  <div class="flex flex-1 overflow-hidden">
    <main class="flex flex-col flex-1 overflow-hidden">
      <div class="flex-1 flex items-center justify-center p-8 text-center">
        <p class="text-base-content/40 text-sm">Nenhuma mensagem ainda.</p>
      </div>

      <div class="p-4 border-t border-base-300">
        <input
          type="text"
          disabled
          placeholder="Mensagens em breve..."
          class="w-full input min-h-[44px]"
          title="Mensagens em breve"
        />
      </div>
    </main>

    <aside class={[
      "md:flex md:flex-col w-56 border-l border-base-300 p-4 bg-base-200",
      if(@show_sidebar, do: "flex flex-col", else: "hidden")
    ]}>
      <h2 class="text-sm font-semibold text-base-content/60 mb-3">Participantes</h2>
      <p class="text-xs text-base-content/40">Em breve</p>
    </aside>
  </div>
</div>
