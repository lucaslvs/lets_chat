[
  exit: "low",
  skip: true,
  # Config.Headers and Config.CSP are false positives: put_csp_headers calls
  # put_secure_browser_headers/2 with a runtime content-security-policy header,
  # setting all secure browser headers in a single call. Sobelow's static analysis
  # cannot trace through private functions to confirm this.
  ignore: ["Config.Headers", "Config.CSP"]
]
